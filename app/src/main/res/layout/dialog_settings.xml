<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تنظیمات مدیران" android:textStyle="bold" android:textSize="18sp"/>
        <EditText android:id="@+id/etManager1" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="شماره مدیر 1 (همیشه فعال)" android:inputType="phone"/>
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/etManager2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="شماره مدیر 2" android:inputType="phone"/>
            <CheckBox android:id="@+id/cbManager2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="فعال"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/etManager3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="شماره مدیر 3" android:inputType="phone"/>
            <CheckBox android:id="@+id/cbManager3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="فعال"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بازه دمای نرمال سنسورها (°C)" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="16dp"/>
        
        <!-- سنسور 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سنسور 1:  "/>
            <EditText android:id="@+id/etS1Min" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="حداقل" android:inputType="numberDecimal"/>
            <EditText android:id="@+id/etS1Max" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="حداکثر" android:inputType="numberDecimal"/>
        </LinearLayout>

        <!-- سنسور 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سنسور 2:  "/>
            <EditText android:id="@+id/etS2Min" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="حداقل" android:inputType="numberDecimal"/>
            <EditText android:id="@+id/etS2Max" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="حداکثر" android:inputType="numberDecimal"/>
        </LinearLayout>

        <!-- سنسور 3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سنسور 3:  "/>
            <EditText android:id="@+id/etS3Min" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="حداقل" android:inputType="numberDecimal"/>
            <EditText android:id="@+id/etS3Max" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="حداکثر" android:inputType="numberDecimal"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
