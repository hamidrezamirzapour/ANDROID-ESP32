<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1D24"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TCP Socket &amp; SMS Settings"
            android:textColor="#00D2D3"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#333A48" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP32 IP Address:"
            android:textColor="#A0AAB8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etIpAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#252932"
            android:fontFamily="monospace"
            android:hint="192.168.4.1"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555E6D"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TCP Port:"
            android:textColor="#A0AAB8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#252932"
            android:fontFamily="monospace"
            android:hint="8888"
            android:inputType="number"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555E6D"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temperature Alert Threshold (°C):"
            android:textColor="#A0AAB8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#252932"
            android:fontFamily="monospace"
            android:hint="50.0"
            android:inputType="numberDecimal"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555E6D"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbEnableSms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:buttonTint="#00D2D3"
            android:text="Enable SMS Warning Alerts"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipient Phone Number:"
            android:textColor="#A0AAB8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#252932"
            android:fontFamily="monospace"
            android:hint="+98912..."
            android:inputType="phone"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555E6D"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>